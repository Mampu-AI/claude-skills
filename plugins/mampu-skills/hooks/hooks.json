{
  "description": "AI-native work loop: surfaces the team task, records and help pages for each prompt, tracks PR/promote milestones and changes (project files, commits, client changes in Sapot Chat), holds the session for a task and its close-out, and runs the background records review.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session_start.sh", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" self_update.sh", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" prompt_match.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" milestone.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|mcp__.*sapot-flows__.*",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" change_seen.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "mcp__.*mampu-tech-team__team_task_start",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" start_seen.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "mcp__.*mampu-tech-team__team_task_finish",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" finish_seen.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" work_seen.sh", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" review_trigger.py", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" stop_gate.sh", "timeout": 10 },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" review_apply.py", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session_end.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
